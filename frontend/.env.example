# Copy this file to .env.local and fill it in from Supabase: Project Settings → API Keys.
# Everything prefixed with VITE_ is shipped to the browser, so never put the
# service-role / secret key here. That key belongs only in Edge Function secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Screens show built-in sample data until this is set to false (default: true).
# Switch it off once the database tables exist.
VITE_USE_SAMPLE_DATA=true
